# Quarto working dir (safe to delete; _freeze/ IS committed on purpose so that
# notebook/code outputs are never re-executed on another machine)
/.quarto/

# Private staging area for concept pages that must not reach the public repo
# (e.g. material derived from unpublished manuscripts). Quarto ignores any
# folder starting with "_", and git ignores this one.
/physical-picture/_drafts/
/implementation/_drafts/

# Throwaway preview folders: rendered locally, never committed.
/physical-picture/preview-*/
/implementation/preview-*/

# Python
.venv/
__pycache__/
.ipynb_checkpoints/

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.history/

**/*.quarto_ipynb
